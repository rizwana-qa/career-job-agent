# Claude API
CLAUDE_API_KEY=

# n8n
N8N_WEBHOOK_URL=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server
PORT=3000

# Job discovery (Remotive — public API, no key required)
# Minimum hours between real Remotive API calls. Remotive's own published
# guidance is a maximum of ~4 calls/day; the default below is well within that.
REMOTIVE_MIN_FETCH_INTERVAL_HOURS=6

# WhatsApp notifications (Meta WhatsApp Business Cloud API — official, direct)
# See docs/AGENTS.md -> Notifications for setup steps. Never commit real values.
WHATSAPP_PROVIDER=whatsapp-cloud-api
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=

# n8n orchestration API (POST /career/run) — shared secret, generate your own.
# Required: Authorization: Bearer <CAREER_AGENT_API_KEY> on every request.
# Never commit a real value. If unset, the endpoint refuses all requests.
CAREER_AGENT_API_KEY=
