{
  "name": "career-job-agent",
  "version": "0.1.0",
  "description": "Personal AI Career Agent foundation — finds, evaluates, and prepares tailored job applications for human review.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:claude": "tsx tests/integration/claude.manual.ts",
    "test:claude:resume": "tsx tests/integration/resumeTailoring.manual.ts",
    "test:claude:resume-qa": "tsx tests/integration/resumeQA.manual.ts",
    "test:claude:application": "tsx tests/integration/applicationPackage.manual.ts",
    "test:jobs:live": "tsx tests/integration/jobsLive.manual.ts",
    "test:whatsapp": "tsx tests/integration/whatsapp.manual.ts",
    "test:career:live": "tsx tests/integration/careerRun.manual.ts",
    "verify:vercel": "tsx tests/integration/vercelEntry.manual.ts",
    "lint": "eslint . --ext .ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^8.57.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
